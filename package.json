{
  "name": "x-modoki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-traceability.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 . && steiger ./src && node scripts/check-src-layers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.ts",
    "verify": "pnpm docs:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --coverage && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/s3-request-presigner": "3.1166.0",
    "@base-ui/react": "1.9.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "better-auth": "1.7.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "twitter-text": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "lighthouse": "13.6.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "steiger": "0.10.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
