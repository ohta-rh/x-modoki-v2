# Copy to .env.local (scripts/setup-local.sh does it and fills the empty values).
# Validated by src/shared/config/env.ts: a missing or malformed value stops `next build` and `next start`.

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgres://xmodoki:xmodoki@localhost:54320/xmodoki

# Better Auth: 32+ random characters, and the URL the app is served from
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# S3-compatible storage: Garage locally (ADR-0008)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=xmodoki-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_MEDIA_BASE_URL=http://xmodoki-media.web.garage.localhost:3902

# Protects POST /api/cron/* (16+ random characters)
CRON_SECRET=
